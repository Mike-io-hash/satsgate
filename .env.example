# Copy this file to .env and adjust values.
# These defaults are production-shaped: the process refuses to start until the
# signing secret is strong and dev/mock mode is off. For local mock testing,
# uncomment the "Local development" block instead of using these values.

# production refuses a weak secret, SATSGATE_DEV_MODE=1, and WALLET_MODE=mock.
# Use development, dev, local, or test for local mock mode.
SATSGATE_ENV=production

# HMAC key for v2 paywall tokens. Required in every environment.
# Production rejects empty, known defaults (including dev-change-me), and
# anything shorter than 32 bytes. Generate one with:
#   openssl rand -hex 32
SATSGATE_MACAROON_SECRET=

# Optional key id. To keep verifying tokens signed by a retired key:
# SATSGATE_MACAROON_KEY_ID=1
# SATSGATE_MACAROON_PREVIOUS_KEYS={"0":"<previous secret>"}
SATSGATE_MACAROON_KEY_ID=1

# Demo price for /v1/tickets (dev-only, in sats)
SATSGATE_PRICE_SATS=10

# Token TTL (seconds)
SATSGATE_TOKEN_TTL_SECONDS=600

# Wallet backend:
# - lnaddr => real invoices via your Lightning Address (LNURL-pay)
# - mock   => simulated wallet, only when SATSGATE_ENV is a local environment
SATSGATE_WALLET_MODE=lnaddr

# Required if WALLET_MODE=lnaddr. Example: user@domain
SATSGATE_LIGHTNING_ADDRESS=

# BOLT11 network the LNURL provider must return. mainnet unless you opt out.
# SATSGATE_LN_NETWORK=mainnet

# DB (SQLite). If empty, uses ./satsgate.sqlite3
SATSGATE_DB_PATH=

# Rate limit (in-memory, capped). Unknown API keys share the client IP bucket.
SATSGATE_RL_ENABLED=1
SATSGATE_RL_WINDOW_SECONDS=60
SATSGATE_RL_MAX_ANON=60
SATSGATE_RL_MAX_AUTH=600
SATSGATE_RL_MAX_CHALLENGE=30
SATSGATE_RL_MAX_TOPUP=10
SATSGATE_RL_MAX_KEYS=10000

# Caps on unpaid rows (invoice spam / DB growth).
SATSGATE_MAX_PENDING_TOPUPS_PER_IP=20
SATSGATE_MAX_OPEN_CHALLENGES_PER_CLIENT=100

# Peers allowed to set X-Forwarded-For (comma-separated IPs or CIDRs).
# Leave empty to ignore proxy headers. Docker Compose sets this to Caddy.
# Do not use "*" or 0.0.0.0/0.
SATSGATE_TRUSTED_PROXIES=

# Uvicorn --forwarded-allow-ips. Docker Compose pins Caddy at 172.28.0.2.
# SATSGATE_FORWARDED_ALLOW_IPS=172.28.0.2

# Operator/admin token.
# When set, enables /v1/admin/* endpoints (protected via X-Admin-Token header).
SATSGATE_ADMIN_TOKEN=

# Hostname used by Caddy (docker-compose). Example: api.satsgate.org
SATSGATE_HOSTNAME=

# Dev routes (/dev/mock/pay, /v1/tickets, /v1/spend) also require a local
# SATSGATE_ENV. They stay off in production even if this is set to 1.
SATSGATE_DEV_MODE=0

# --- Local development (mock wallet, no Lightning) ---
# SATSGATE_ENV=development
# SATSGATE_DEV_MODE=1
# SATSGATE_WALLET_MODE=mock
# SATSGATE_MACAROON_SECRET=<any non-empty local value>
