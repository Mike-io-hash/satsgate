# Copy this file to .env and adjust values.
# These defaults are production-shaped: the process refuses to start until the
# signing secret is strong and dev/mock mode is off. For local mock testing,
# uncomment the "Local development" block instead of using these values.

# production refuses a weak secret, SATSGATE_DEV_MODE=1, and WALLET_MODE=mock.
# Use development, dev, local, or test for local mock mode.
SATSGATE_ENV=production

# HMAC key for v2 paywall tokens. Required in every environment.
# Production rejects empty, known defaults (including dev-change-me), and
# anything shorter than 32 bytes. Generate one with:
#   openssl rand -hex 32
SATSGATE_MACAROON_SECRET=

# Optional key id. To keep verifying tokens signed by a retired key:
# SATSGATE_MACAROON_KEY_ID=1
# SATSGATE_MACAROON_PREVIOUS_KEYS={"0":"<previous secret>"}
SATSGATE_MACAROON_KEY_ID=1

# Demo price for /v1/tickets (dev-only, in sats)
SATSGATE_PRICE_SATS=10

# Minimum seconds a paywall invoice must stay payable, and the dev-ticket
# macaroon TTL. Paywall macaroons follow the invoice expiry (below), not this.
SATSGATE_TOKEN_TTL_SECONDS=600

# Top-up macaroons follow the invoice expiry (stored expires_at) plus the grace
# below, and never live longer than the cap. Both are optional.
# SATSGATE_TOPUP_CLAIM_GRACE_SECONDS=3600
# SATSGATE_TOPUP_TOKEN_TTL_CAP_SECONDS=172800

# Paywall macaroons follow the invoice expiry plus this grace, and never live
# longer than this cap. Same defaults as top-ups. Both are optional.
# SATSGATE_PAYWALL_CLAIM_GRACE_SECONDS=3600
# SATSGATE_PAYWALL_TOKEN_TTL_CAP_SECONDS=172800

# Wallet backend:
# - lnaddr => real invoices via your Lightning Address (LNURL-pay)
# - mock   => simulated wallet, only when SATSGATE_ENV is a local environment
SATSGATE_WALLET_MODE=lnaddr

# Required if WALLET_MODE=lnaddr. Example: user@domain
# If that provider returns a LUD-21 verify URL (Alby does), buyers can finish
# a top-up by polling after they pay. No extra setting is required.
SATSGATE_LIGHTNING_ADDRESS=

# BOLT11 network the LNURL provider must return. mainnet unless you opt out.
# SATSGATE_LN_NETWORK=mainnet

# LUD-12 comment on LNURL-pay callbacks. Leave off (the default). Some hosts,
# including Alby, put the comment in the BOLT11 description and drop
# description_hash = SHA256(metadata), which satsgate rejects.
# SATSGATE_LNURL_SEND_COMMENT=0

# DB (SQLite). If empty, uses ./satsgate.sqlite3
SATSGATE_DB_PATH=

# Rate limit (in-memory, capped). Unknown API keys share the client IP bucket.
SATSGATE_RL_ENABLED=1
SATSGATE_RL_WINDOW_SECONDS=60
SATSGATE_RL_MAX_ANON=60
SATSGATE_RL_MAX_AUTH=600
SATSGATE_RL_MAX_CHALLENGE=30
SATSGATE_RL_MAX_TOPUP=10
SATSGATE_RL_MAX_KEYS=10000

# Caps on unpaid rows (invoice spam / DB growth).
SATSGATE_MAX_PENDING_TOPUPS_PER_IP=20
SATSGATE_MAX_OPEN_CHALLENGES_PER_CLIENT=100

# Per-buyer challenge limits. Used only when a trusted proxy sends
# X-Satsgate-Buyer-Ip. 0 disables that limit. The rate window is
# SATSGATE_RL_WINDOW_SECONDS. Scope "client" (default) or "key".
SATSGATE_BUYER_CHALLENGE_MAX=10
SATSGATE_BUYER_MAX_OPEN_CHALLENGES=5
SATSGATE_CHALLENGE_REUSE_SECONDS=30
SATSGATE_BUYER_LIMIT_SCOPE=client

# Peers allowed to set X-Forwarded-For (comma-separated IPs or CIDRs).
# Leave empty to ignore proxy headers. Docker Compose sets this to Caddy.
# Do not use "*" or 0.0.0.0/0.
SATSGATE_TRUSTED_PROXIES=

# Uvicorn --forwarded-allow-ips. Docker Compose pins Caddy at 172.28.0.2.
# SATSGATE_FORWARDED_ALLOW_IPS=172.28.0.2

# Operator/admin token.
# When set, enables /v1/admin/* endpoints (protected via X-Admin-Token header).
SATSGATE_ADMIN_TOKEN=

# Hostname used by Caddy (docker-compose). Example: api.satsgate.org
SATSGATE_HOSTNAME=

# Apex hostname for the connect page. Example: satsgate.org
# Caddy will not start until this is set, because the site block is in the same file.
# SATSGATE_SITE_HOSTNAME=satsgate.org

# Reown AppKit project ID. Not a secret (it is visible in the page and protected by the Reown domain allowlist), but keep it out of the repo.
SATSGATE_REOWN_PROJECT_ID=

# USDC. SATSGATE_X402_NETWORK must stay eip155:84532. That is the public
# facilitator network (Base Sepolia). Do not set it to eip155:8453. Core
# refuses to boot. Base mainnet is the switch below, not this variable.
# SATSGATE_X402_FACILITATOR_URL=https://x402.org/facilitator
# SATSGATE_X402_NETWORK=eip155:84532
# SATSGATE_X402_OFFER_SECONDS=60
# Payee signature window, seconds. Default 1800. Values outside 300–3600 are clamped.
# SATSGATE_X402_PAYEE_CHALLENGE_SECONDS=1800
# One-time connect link lifetime, seconds. Default 3600. Values outside 600–86400 are clamped.
# SATSGATE_PAYEE_CONNECT_SECONDS=3600
# Browser URL used in the connect link. https, with the page path, no query or fragment.
# SATSGATE_CONNECT_PUBLIC_BASE=https://satsgate.org/connect

# Smart-wallet payee checks and optional security-alert email. Core only.
# SATSGATE_SMART_WALLETS=0 restores the previous "65-byte signatures only" answers.
# The RPC URL is a secret: do not log it. A path is allowed. No userinfo, query, or fragment.
# SATSGATE_SMART_WALLETS=1
# SATSGATE_BASE_RPC_URL=https://mainnet.base.org
# Optional second Base RPC. Empty by default. https, no userinfo, query, or fragment.
# SATSGATE_BASE_RPC_FALLBACK_URL=
# Effective BTC/USD quote. Cache default 60 seconds. Primary freshness 3600 seconds.
# The backup quote uses SATSGATE_RATES_STALE_SECONDS (180). Timeout is the RPC call.
# SATSGATE_ACCOUNTING_RATE_CACHE_S=60
# SATSGATE_ACCOUNTING_RATE_STALE_S=3600
# SATSGATE_ACCOUNTING_RATE_TIMEOUT_S=3
# Empty SATSGATE_RESEND_API_KEY turns alert email off. The key is created at deploy and never committed.
# SATSGATE_RESEND_API_KEY=
# SATSGATE_EMAIL_FROM=Satsgate <alerts@satsgate.org>
# SATSGATE_SUPPORT_EMAIL=satsgateapp@proton.me
# SATSGATE_EMAIL_ENABLED=1

# Base mainnet USDC through the Coinbase CDP facilitator. Default off.
# Copying this file does not enable mainnet. Set the switch to 1 and both
# credentials, then restart core. The secret is the CDP Secret API key
# (base64, shown once). The gate container must not receive these.
# SATSGATE_X402_CDP=0
# SATSGATE_X402_CDP_KEY_ID=
# SATSGATE_X402_CDP_KEY_SECRET=

# USDC credit packs (optional). Satsgate's own Base address. Unset or invalid
# disables GET /v1/topup/{plan_id}/x402. Lightning top-up keeps working.
# While SATSGATE_X402_CDP is on, packs are sold for Base mainnet USDC only.
# While it is off, packs stay on Base Sepolia. Credits are not sold for
# faucet USDC once mainnet is on.
# SATSGATE_TREASURY_EVM_ADDRESS=0x...

# Dev routes (/dev/mock/pay, /v1/tickets, /v1/spend) also require a local
# SATSGATE_ENV. They stay off in production even if this is set to 1.
SATSGATE_DEV_MODE=0

# Hosted-gate receipts. Default 86400 seconds, clamped to 60–86400 and to
# the paywall access cap. A route access_seconds overrides this.
# SATSGATE_RECEIPT_SECONDS=86400

# Terms stay unpublished until legal review. Leave the version empty.
# Auto-approve refuses to boot when it is on and this version is empty.
# SATSGATE_TERMS_VERSION=
# SATSGATE_TERMS_URL=
# SATSGATE_SITES_AUTO_APPROVE=0

# Abuse contact shown on the gate. A bare email address, or empty.
# SATSGATE_ABUSE_CONTACT=

# Credit-pack country refusals. Empty means no lookup and no database is required.
# A non-empty list with a missing database refuses new pack quotes (503).
# SATSGATE_GEOBLOCK_COUNTRIES=
# SATSGATE_GEOIP_DB=/data/geoip/dbip-country-lite.mmdb
# SATSGATE_OFAC_EVM_FILE=/data/ofac/ofac_evm.txt

# Gate test-mode rate limits (used when the cached site is x402_mode=test).
# SATSGATE_GATE_RL_TEST_PER_BUYER=10
# SATSGATE_GATE_RL_TEST_PER_SITE=60

# --- Local development (mock wallet, no Lightning) ---
# SATSGATE_ENV=development
# SATSGATE_DEV_MODE=1
# SATSGATE_WALLET_MODE=mock
# SATSGATE_MACAROON_SECRET=<any non-empty local value>
